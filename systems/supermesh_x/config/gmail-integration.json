  "capabilities": [
    "communications.email.search",
    "communications.email.thread",
    "communications.email.attachment",
    "research.newsletter.private",
    "alerts.email.market_event"
  ],
  "read_surfaces": [
    "search",
    "messages",
    "threads",
    "attachments",
    "labels",
    "draft_metadata"
