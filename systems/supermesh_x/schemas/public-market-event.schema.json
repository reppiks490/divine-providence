{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicMarketEvent",
  "type": "object",
  "required": ["actor", "event_time", "source_class", "public_only"],
  "properties": {
    "actor": {"type": "string"},
    "event_time": {"type": "string"},
    "published_time": {"type": ["string", "null"]},
    "available_time": {"type": ["string", "null"]},
    "retrieved_time": {"type": ["string", "null"]},
    "source_class": {"type": "string"},
    "platform": {"type": ["string", "null"]},
    "topics": {"type": "array", "items": {"type": "string"}},
    "themes": {"type": "array", "items": {"type": "string"}},
    "channels": {"type": "array", "items": {"type": "string"}},
    "public_only": {"const": true},
    "private_location_tracking": {"const": false}
  },
  "additionalProperties": true
}
