{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuperMesh-X Tool Surface Snapshot",
  "type": "object",
  "required": ["provider", "captured_at", "tools"],
  "properties": {
    "provider": {"type": "string"},
    "captured_at": {"type": "string"},
    "version": {"type": ["string", "null"]},
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "schema_fingerprint"],
        "properties": {
          "name": {"type": "string"},
          "schema_fingerprint": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
