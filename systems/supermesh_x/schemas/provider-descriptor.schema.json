{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"SuperMesh-X Provider Descriptor",
  "type":"object",
  "required":["name","capabilities","runtime_targets","transports"],
  "properties":{
    "name":{"type":"string","minLength":1},
    "capabilities":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "runtime_targets":{"type":"array","items":{"enum":["chatgpt","codex","claude","other"]}},
    "transports":{"type":"array","items":{"type":"string"}},
    "auth_modes":{"type":"array","items":{"type":"string"}},
    "trust_class":{"enum":["public","sandbox","enterprise","regulated","unknown"]},
    "dynamic":{"type":"boolean"},
    "preflight":{"type":["string","null"]},
    "cost_class":{"type":["string","null"]}
  },
  "additionalProperties":true
}
