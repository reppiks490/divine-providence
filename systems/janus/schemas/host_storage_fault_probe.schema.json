{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JANUS Host Storage Fault Probe v1",
  "type": "object",
  "required": ["format", "mechanism", "max_file_bytes", "attempted_bytes", "target_path", "returncode", "classification", "resulting_size_bytes", "probe_digest"],
  "properties": {
    "format": {"const": "janus-host-storage-fault-probe-v1"},
    "mechanism": {"const": "RLIMIT_FSIZE"},
    "classification": {"enum": ["kernel_file_size_limit", "kernel_storage_error", "unexpected_write_success", "probe_failed"]},
    "errno": {"type": ["integer", "null"]},
    "errno_name": {"type": ["string", "null"]},
    "resulting_size_bytes": {"type": "integer", "minimum": 0},
    "probe_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
