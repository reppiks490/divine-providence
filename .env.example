# Copy to .env (git-ignored) or set in the MCP registration with -e.
# Live ICARUS engine (icarus-bridge) HTTP API; loopback only.
ICARUS_ENGINE_URL=http://127.0.0.1:8791
# Bearer token for the engine's /api/research routes. Never commit the real value.
ICARUS_ENGINE_TOKEN=
# Optional: TradingView CSV corpus root for systems/nexus/scripts/real_smoke.py
NEXUS_CSV_ROOT=
