{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASCENSION Capability Packet",
  "type": "object",
  "required": [
    "capability_id",
    "name",
    "version",
    "cycle_id",
    "status",
    "problem",
    "hypothesis",
    "beneficiaries",
    "authority_exclusions",
    "dependencies",
    "interfaces",
    "evidence",
    "evaluation_vector",
    "acceptance_tests",
    "negative_tests",
    "regression_tests",
    "failure_modes",
    "rollback",
    "observability",
    "compatibility",
    "artifacts",
    "revalidation",
    "next_experiment"
  ],
  "properties": {
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "IDEA",
        "SHADOW",
        "CANDIDATE",
        "VERIFIED",
        "OFFERED",
        "ADOPTED_EXTERNALLY",
        "DEPRECATED",
        "QUARANTINED"
      ]
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "beneficiaries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "authority_exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "interface_version",
          "required_inputs",
          "emitted_outputs",
          "assumptions",
          "invariants"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "interface_version": {
            "type": "string"
          },
          "required_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "emitted_outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "invariants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evaluation_vector": {
      "type": "object",
      "properties": {
        "correctness": {
          "type": [
            "number",
            "null"
          ]
        },
        "reproducibility": {
          "type": [
            "number",
            "null"
          ]
        },
        "transferability": {
          "type": [
            "number",
            "null"
          ]
        },
        "integration_cost": {
          "type": [
            "number",
            "null"
          ]
        },
        "latency_cost_burden": {
          "type": [
            "number",
            "null"
          ]
        },
        "observability": {
          "type": [
            "number",
            "null"
          ]
        },
        "rollback_safety": {
          "type": [
            "number",
            "null"
          ]
        },
        "non_interference": {
          "type": [
            "number",
            "null"
          ]
        },
        "evidence_quality": {
          "type": [
            "number",
            "null"
          ]
        },
        "reuse_breadth": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "acceptance_tests": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "negative_tests": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "regression_tests": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "type": "object"
    },
    "observability": {
      "type": "object"
    },
    "compatibility": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revalidation": {
      "type": "object"
    },
    "next_experiment": {
      "type": "string"
    }
  },
  "additionalProperties": false
}