@@ -0,0 +1,74 @@
+name: OMNIVISION Trust Substrate
+
+on:
+  push:
+    branches:
+      - codex/exotic-research-loop
+    paths:
+      - "icarus_engine/**"
+      - "tests_engine/**"
+      - "pyproject.toml"
+      - ".github/workflows/omnivision-stage0.yml"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: omnivision-stage0-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  verify:
+    name: Python ${{ matrix.python-version }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    strategy:
+      fail-fast: false
+      matrix:
+        python-version: ["3.10", "3.11", "3.12", "3.13"]
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: ${{ matrix.python-version }}
+          cache: pip
+
+      - name: Install development dependencies
+        run: python -m pip install --upgrade pip && python -m pip install -e ".[dev]"
+
+      - name: Compile affected Python
+        run: python -m compileall -q icarus_engine tests_engine
+
+      - name: Run OMNIVISION foundation regressions
+        run: >
+          python -m pytest
+          tests_engine/test_world_state.py
+          tests_engine/test_omnivision_contracts.py
+          tests_engine/test_omnivision_bridge.py
+          tests_engine/test_omnivision_hypotheses.py
+          tests_engine/test_omnivision_novelty.py
+          tests_engine/test_omnivision_falsification.py
+          tests_engine/test_omnivision_candidates.py
+          tests_engine/test_omnivision_integration.py
+          tests_engine/test_omnivision_stage0_temporal.py
+          tests_engine/test_omnivision_stage0_boundaries.py
+          tests_engine/test_omnivision_capabilities.py
+          tests_engine/test_omnivision_admissibility.py
+          tests_engine/test_omnivision_provenance.py
+          tests_engine/test_omnivision_trials.py
+          tests_engine/test_omnivision_stage1_integration.py
+          tests_engine/test_advisory.py
+          tests_engine/test_research.py
+          -q
+
+      - name: Run full engine suite
+        run: python -m pytest tests_engine -q
+
+      - name: Record slowest tests
+        if: matrix.python-version == '3.11'
+        run: python -m pytest tests_engine -q --durations=20
